# Local Ollama service
LLM_MODE=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=iKhalid/ALLaM:7b
OLLAMA_TIMEOUT_SECONDS=120

# Local knowledge and memory stores
MAWJAH_DOCS_DIR=docs
CHROMA_COLLECTION=mowjn_knowledge_qwen3
CHROMA_PERSIST_DIR=.chroma_knowledge
MEMORY_COLLECTION=mowjn_memories
MEMORY_PERSIST_DIR=.chroma_memories
MEMORY_ENABLED=true
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B

# Keep community sync disabled until explicitly configured
TELEMETRY_ENDPOINT=
PORT=8000
HOST=127.0.0.1
